<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TrophyPrompt.ViewModels"
        x:Class="TrophyPrompt.Views.TimestampDialog"
        x:DataType="vm:TimestampDialogViewModel"
        Title="Pick time" Width="360" Height="260"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="10">
    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15" />
    <DatePicker SelectedDate="{Binding DatePart, Mode=TwoWay}" />
    <TimePicker SelectedTime="{Binding TimePart, Mode=TwoWay}" ClockIdentifier="24HourClock" />
    <TextBlock Text="{Binding Error}" Foreground="Red" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Random" Click="OnRandomClick" />
      <Button Content="Cancel" Click="OnCancelClick" />
      <Button Content="OK" Classes="accent" Click="OnOkClick" />
    </StackPanel>
  </StackPanel>
</Window>
