<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Trophy.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models/" />
    <AvaloniaResource Include="Assets/**" />
    <Compile Remove="vendor/**" />
    <EmbeddedResource Remove="vendor/**" />
    <None Remove="vendor/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="vendor/TROPHYParser/TROPHYParser.csproj" />
    <ProjectReference Include="vendor/BigEndianTool/BigEndianTool.csproj" />
    <ProjectReference Include="vendor/pfdtool/pfdtool.csproj" />
  </ItemGroup>

  <Target Name="CopyPfdtoolNativeFiles" AfterTargets="Build">
    <ItemGroup>
      <PfdtoolNativeFiles Include="vendor/pfdtool/pfdtool.exe" />
      <PfdtoolNativeFiles Include="vendor/pfdtool/msvcr100.dll" />
      <PfdtoolNativeFiles Include="vendor/pfdtool/games.conf" />
      <PfdtoolNativeFiles Include="vendor/pfdtool/global.conf" />
    </ItemGroup>
    <Copy SourceFiles="@(PfdtoolNativeFiles)" DestinationFolder="$(OutputPath)pfdtool" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPfdtoolNativeFilesPublish" AfterTargets="Publish">
    <ItemGroup>
      <PfdtoolNativeFiles Include="vendor/pfdtool/pfdtool.exe" />
      <PfdtoolNativeFiles Include="vendor/pfdtool/msvcr100.dll" />
      <PfdtoolNativeFiles Include="vendor/pfdtool/games.conf" />
      <PfdtoolNativeFiles Include="vendor/pfdtool/global.conf" />
    </ItemGroup>
    <Copy SourceFiles="@(PfdtoolNativeFiles)" DestinationFolder="$(PublishDir)pfdtool" SkipUnchangedFiles="true" />
  </Target>
</Project>