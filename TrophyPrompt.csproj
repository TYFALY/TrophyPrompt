<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/Trophy.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models/" />
    <AvaloniaResource Include="Assets/**" />
    <Compile Remove="vendor/**" />
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="vendor/**" />
    <None Remove="vendor/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.6" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.6" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.6" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.6" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="vendor/TROPHYParser/TROPHYParser.csproj" />
    <ProjectReference Include="vendor/BigEndianTool/BigEndianTool.csproj" />
  </ItemGroup>

  <!--
    pfdtool: Windows uses flatz's original pfdtool.exe (vendor/pfdtool).
    macOS/Linux use a native build of the same tool placed at
    vendor/pfdtool/native/<rid>/pfdtool (built by CI, or locally with
    scripts/build-pfdtool.sh). The .conf files are shared by both.
  -->
  <PropertyGroup>
    <PfdtoolRid>$(RuntimeIdentifier)</PfdtoolRid>
    <PfdtoolRid Condition="'$(PfdtoolRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</PfdtoolRid>
    <PfdtoolIsWindows>false</PfdtoolIsWindows>
    <PfdtoolIsWindows Condition="$(PfdtoolRid.StartsWith('win'))">true</PfdtoolIsWindows>
  </PropertyGroup>

  <ItemGroup>
    <PfdtoolFiles Include="vendor/pfdtool/games.conf;vendor/pfdtool/global.conf" />
    <PfdtoolFiles Include="vendor/pfdtool/pfdtool.exe;vendor/pfdtool/msvcr100.dll" Condition="'$(PfdtoolIsWindows)' == 'true'" />
    <PfdtoolFiles Include="vendor/pfdtool/native/$(PfdtoolRid)/pfdtool" Condition="'$(PfdtoolIsWindows)' != 'true' and Exists('vendor/pfdtool/native/$(PfdtoolRid)/pfdtool')" />
  </ItemGroup>

  <Target Name="CopyPfdtoolNativeFiles" AfterTargets="Build">
    <Copy SourceFiles="@(PfdtoolFiles)" DestinationFolder="$(OutputPath)pfdtool" SkipUnchangedFiles="true" />
    <Warning Condition="'$(PfdtoolIsWindows)' != 'true' and !Exists('vendor/pfdtool/native/$(PfdtoolRid)/pfdtool')"
             Text="No native pfdtool for $(PfdtoolRid). Run scripts/build-pfdtool.sh to build one, or opening trophy folders will fail." />
  </Target>

  <Target Name="CopyPfdtoolNativeFilesPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(PfdtoolFiles)" DestinationFolder="$(PublishDir)pfdtool" SkipUnchangedFiles="true" />
  </Target>
</Project>